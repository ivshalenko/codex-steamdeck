{
  "name": "codex-steamdeck",
  "version": "1.0.0-rc.25",
  "description": "Multi-provider AI assistant for Steam Deck Gaming Mode",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && rollup -c --forceExit",
    "watch": "rollup -c -w",
    "test": "tsc --noEmit && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ivshalenko/codex-steamdeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "ivshalenko and Deck AI contributors",
  "bugs": {
    "url": "https://github.com/ivshalenko/codex-steamdeck/issues"
  },
  "homepage": "https://github.com/ivshalenko/codex-steamdeck",
  "devDependencies": {
    "@decky/ui": "^4.11.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "^5.1.20",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "rollup-plugin-external-globals": "^0.13.0",
    "rollup-plugin-import-assets": "^1.1.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "2.0.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
