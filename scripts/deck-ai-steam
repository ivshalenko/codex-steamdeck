#!/usr/bin/env bash
set -euo pipefail
export DECK_AI_GAMING=1
export GDK_BACKEND=x11
APP_DIR=""
for candidate in "$HOME/.local/share/deck-ai" "$HOME/.local/share/deck-voice" "$HOME/.local/share/codex-steamdeck"; do
  if [[ -f "$candidate/app.py" ]]; then APP_DIR="$candidate"; break; fi
done
if [[ -z "$APP_DIR" ]]; then echo "Deck AI is not installed. Run install.sh first." >&2; exit 1; fi
exec "$APP_DIR/venv/bin/python" "$APP_DIR/app.py" "$@"
